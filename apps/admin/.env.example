# Dedicated MongoDB database. Local Mongo must run as a replica set for transactions.
DATABASE_URL=mongodb://127.0.0.1:27017/lumia_order?replicaSet=rs0&directConnection=true
# Atlas alternative: mongodb+srv://USER:PASSWORD@CLUSTER/lumia_order?retryWrites=true&w=majority
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Server-only Meta credentials. Use an approved AUTHENTICATION copy-code template.
# Public URL of the existing landing page for Terms / Privacy links.
NEXT_PUBLIC_MARKETING_URL=http://localhost:5173
# Explicit opt-in, development only. Does not bypass WhatsApp verification.
ALLOW_DEMO_SEED=false
DEMO_PHONE_NUMBER=

# Optional approved Arabic template; English is used until configured.

# lumia-order-api (owns WhatsApp delivery and AI menu reading). Server-only.
# INTERNAL_API_KEY must equal the same variable in lumia-order-api (32+ random characters).
LUMIA_API_URL=http://localhost:4000
INTERNAL_API_KEY=

# Local testing only (ignored when NODE_ENV=production): skip the WhatsApp message and accept code 111111
AUTH_TEST_MODE=false

# Encrypts customers' WhatsApp access tokens at rest. Generate: openssl rand -base64 32
WHATSAPP_TOKEN_ENCRYPTION_KEY=
# WhatsApp Embedded Signup (from your Meta app). Public values used by the browser SDK.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v25.0
# Local UI testing only (ignored in production): "Connect WhatsApp" simulates Meta with sample data instead of opening the Meta popup
WHATSAPP_LINK_TEST_MODE=false
