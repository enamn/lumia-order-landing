# Lumia Order realtime service (terminals and open dashboards connect here by WebSocket). Build context: apps/admin.
# Cloud Run: concurrency 1000, request timeout 3600 s, minInstances 1. Listens on $PORT (default 8080).
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=8080
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY prisma ./prisma
# tsx runs the TypeScript directly, so the dev dependencies stay.
RUN NODE_ENV=development npm ci && npx prisma generate
COPY tsconfig.json ./
COPY src ./src
USER node
EXPOSE 8080
CMD ["node", "--import", "tsx", "src/realtime/main.ts"]
